{
  "stt": {
    "model": "medium",
    "language": "ru",
    "compute_type": "float32",
    "device": "cuda",
    "silero_sensitivity": 0.1,
    "webrtc_sensitivity": 3,
    "silero_deactivity_detection": true,
    "post_speech_silence_duration": 3.0,
    "min_gap_between_recordings": 1.0,
    "min_length_of_recording": 1.0,
    "pre_recording_buffer_duration": 0.2
  },
  "use_llm_for_stt": true,
  "api": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-oss-120b",
    "token": ""
  },
  "app_manager": {
    "winget_timeout_s": 120,
    "uninstall_timeout_s": 120,
    "launch_wait_s": 1.0,
    "subprocess_encoding": "utf-8"
  },
  "script_runner": {
    "default_script_path": "C:/Users/User/Desktop/",
    "timeout": 300.0,
    "is_async": true,
    "strict": false
  },
  "energy_saver": {
    "enabled_lower_refresh_rate_hz_edit": 60
  },
  "screen_tool": {
    "fps_recording_edit": 20
  },
  "browser": {
    "default_choice": "default",
    "custom_path": "",
    "custom_engine": "chromium",
    "custom_search_preset": ""
  }
}